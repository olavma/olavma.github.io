---
import Layout from "../../layouts/Layout.astro";
import '../../styles/main.css';
import '../../styles/navigation.css';
import '../../styles/project.css';
import Navigation from "../../components/Navigation.astro";
import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map(project => ({
    params: { id: String(project.id) } // Astro requiere string
  }));
}

const { id } = Astro.params;
const project = projects.find(p => String(p.id) === id);
---
<Layout title={project ? project.title : "Proyecto no definido"} description={project ? "Proyecto: " + project.title : "Descripción no definida"}>
    <Navigation basePath='../' />
    <main>
        {project ? (
            <section id="proyecto">
                <h4>{project.title}</h4>
                <figure class="portada">
                    <img src={project.logo} alt={project.logoAlt} />
                </figure>
                <article class="sinopsis">
                    <h4>Sinopsis</h4>
                    <p id="full-body" set:html={project.bodyProject}></p>
                </article>
                {project.instructions && (
                    <article class="sinopsis">
                        <h4>Instrucciones</h4>
                        <p id="instructions" set:html={project.instructions}></p>
                    </article>
                )}
                <article class="language">
                    <h4>Idiomas</h4>
                    <p>Puedes leerlo en: <span id="idioma">{project.lang}</span></p>
                </article>
                {project.github && <a href={project.github} class="astro-button" target="_blank">Más info</a>}
                {project.play && <a href={project.play} class="astro-button">Ver</a>}
                {project.example && <a href={project.example} class="astro-button">Ver ejemplo</a>}
            </section>
        ) : (
            <section id="proyecto">
                <h4>Proyecto no definido</h4>
                <p>No existe información de este proyecto.</p>
            </section>
        )}
    </main>
    <Footer />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        getFullBody();
        getInstructions();
    })

    function getFullBody() {
        const fullBody = document.getElementById("full-body");
        const text = fullBody?.innerHTML;
        const paras = text?.split('-YND-');

        if(fullBody && paras) {
            fullBody.innerHTML = '';
            paras.forEach(para => {
                const p = document.createElement('p');
                p.innerHTML = para;
                fullBody.appendChild(p);
            });
        } else {
            console.error('Element with id "full-body" not found')
        }
    }

    function getInstructions() {
        const instructions = document.getElementById("instructions");
        const text = instructions?.innerHTML;
        const paras = text?.split('-YND-');
        
        if(instructions && paras) {
            instructions.innerHTML = '';
            paras.forEach(para => {
                const p = document.createElement('p');
                p.innerHTML = para;
                instructions.appendChild(p);                
            });
        } else {
            console.error('Element with id "instructions" not found')
        }
    }
</script>